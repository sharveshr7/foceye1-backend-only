# FOCEYE Production Backend Environment Variables

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*","https://foceye.vercel.app","https://foceye-backend.onrender.com"]

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=foceye-clinical-super-secret-jwt-key-change-in-production

# AI Inference (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
